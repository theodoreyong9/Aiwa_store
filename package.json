{
  "name": "aiwa-store",
  "version": "0.1.0",
  "private": true,
  "description": "An app store with a wallet, on a protocol that needs no shared ledger.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "registry",
    "apps/*",
    "design-research",
    "video-kit"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "check:docs": "node scripts/check-diagrams.mjs && node scripts/render-diagrams.mjs --check",
    "diagrams": "node scripts/render-diagrams.mjs"
  },
  "devDependencies": {
    "mermaid": "^11.17.2"
  }
}
