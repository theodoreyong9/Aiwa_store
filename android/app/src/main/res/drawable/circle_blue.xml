<?xml version="1.0" encoding="utf-8"?>
<!-- A round button of the widget, HUD style: a filled disc with a neon ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="#2D8CFF" android:endColor="#27D6FF" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#0E63D8" />
        </shape>
    </item>
</layer-list>
