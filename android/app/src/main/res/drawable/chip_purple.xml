<?xml version="1.0" encoding="utf-8"?>
<!-- A button of the widget, HUD style: a dark tinted body and a neon edge (a gradient border made of two layers). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7B5CFF" android:endColor="#C08CFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:top="1.5dp" android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#150F2E" />
            <corners android:radius="12.5dp" />
        </shape>
    </item>
</layer-list>
