<?xml version="1.0" encoding="utf-8"?>
<!-- Glass: a translucent body, a sheen on the upper half, a light edge and, inside it, a brighter line on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#802E9E6D" /><corners android:radius="100dp" /><stroke android:width="1dp" android:color="#9952B089" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#4DFFFFFF" android:centerColor="#0DFFFFFF" android:centerY="0.55" android:endColor="#00FFFFFF" /><corners android:radius="100dp" /></shape></item>
    <item android:top="1dp" android:left="6dp" android:right="6dp" android:height="1dp"><shape android:shape="rectangle"><solid android:color="#59FFFFFF" /><corners android:radius="1dp" /></shape></item>
</layer-list>
