<?xml version="1.0" encoding="utf-8"?>
<!-- Glass: a translucent body, a sheen on the upper half, a light edge and, inside it, a brighter line on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#99CC785C" /><corners android:radius="100dp" /><stroke android:width="1dp" android:color="#CCEBA68C" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#70FFFFFF" android:centerColor="#14FFFFFF" android:centerY="0.5" android:endColor="#00FFFFFF" /><corners android:radius="100dp" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#00000000" android:centerColor="#00000000" android:centerY="0.45" android:endColor="#33000000" /><corners android:radius="100dp" /></shape></item>
</layer-list>
