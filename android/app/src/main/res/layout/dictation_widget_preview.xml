<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview on Android 12+ (previewLayout): the three rows
     of the real widget, drawn with plain views so the launcher can render it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="0dp" android:background="@drawable/preview_circle"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_loop" /></FrameLayout>
        <TextView android:layout_width="62dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/preview_pill" android:gravity="center" android:singleLine="true" android:text="Projet" android:textColor="#F0F0F5" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_weight="1.0" android:layout_height="38dp" android:background="@drawable/preview_pill" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:singleLine="true" android:text="Nouvelle session ▾" android:textColor="#F0F0F5" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="6dp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1.0" android:layout_height="38dp" android:background="@drawable/preview_pill" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:singleLine="true" android:text="⎇ aiwa_store ▾" android:textColor="#F0F0F5" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:singleLine="true" android:text="Campagne" android:textColor="#F0F0F5" android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="0dp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill_green" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:singleLine="true" android:text="Docs" android:textColor="#F0F0F5" android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill_green" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:singleLine="true" android:text="Vidéo" android:textColor="#F0F0F5" android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill_green" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:singleLine="true" android:text="Page" android:textColor="#F0F0F5" android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:background="@drawable/preview_pill_grey" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:singleLine="true" android:text="App" android:textColor="#F0F0F5" android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="0dp" android:background="@drawable/preview_circle"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_settings" /></FrameLayout>
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/preview_circle"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_plus" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/preview_mic_pill"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_agent" /></FrameLayout>
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/preview_circle_orange"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_claude" /></FrameLayout>
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/preview_circle_red"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_question" /></FrameLayout>
    </LinearLayout>
</LinearLayout>
