        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="20dp" android:background="@drawable/chip_teal" android:gravity="center" android:paddingStart="3dp" android:paddingEnd="3dp" android:singleLine="true" android:text="Docs" android:textColor="#F0F0F5" android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
