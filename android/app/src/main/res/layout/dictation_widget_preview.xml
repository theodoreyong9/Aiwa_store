<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview on Android 12+ (previewLayout): the three thin rows
     of the real widget, drawn with plain views so the launcher can render it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp">
