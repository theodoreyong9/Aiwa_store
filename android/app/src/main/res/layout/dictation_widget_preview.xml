        <TextView android:layout_width="56dp" android:layout_weight="0" android:layout_height="24dp" android:background="@drawable/chip_purple" android:gravity="center" android:paddingStart="3dp" android:paddingEnd="3dp" android:singleLine="true" android:text="Projet" android:textColor="#F0F0F5" android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
