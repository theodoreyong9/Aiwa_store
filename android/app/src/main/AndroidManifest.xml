<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed for LocalClaudeBridge's own HTTP calls to the local
         backend — without it no socket can open at all, cleartext
         policy or not. Was never declared here even before this fix. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Real voice dictation (MainActivity's mic button) needs this at
         runtime, requested on first tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The Store reads QR codes with the camera (a payment received, two phones pairing for an app): asked once, when the page first
         opens the camera (StoreActivity.kt). Not every phone has one, and nothing but scanning needs it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 11+ package-visibility: without declaring this,
         resolving/launching RecognizerIntent.ACTION_RECOGNIZE_SPEECH can
         silently fail to find a handler even when one is installed. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Lets the phone's voice (text-to-speech) be used from Android 11 on: it asks which repository, and says "C'est prêt". -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.termux" />
        <!-- Lets openClaudeApp() see whether the Claude app is installed. -->
        <package android:name="com.anthropic.claude" />
    </queries>
    <!-- Termux's own real automation API: lets Aiwa start the backend
         inside Termux directly (TermuxLauncher.kt), without the user
         manually opening Termux and typing anything, once it's been set
         up at least once via bootstrap.sh. Android still makes the user
         grant this once, like any dangerous permission — AND Termux
         itself refuses it unless the user has separately turned on
         "allow-external-apps=true" in ~/.termux/termux.properties; this
         manifest entry alone doesn't bypass that real security gate. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Reported live: "oui je veux que tu implémentes le micro widget
         sans ouvrir l'application dès la première utilisation" — the
         explicit trade-off accepted for KeepAliveService.kt below: a
         real foreground service, with its mandatory persistent
         notification, keeps Aiwa's process resident so DictateActivity
         stops needing to cold-start on first use after an idle period. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ shows no notification without it — and the lock-screen card
         (KeepAliveService.kt) is one. Asked once, when the app is opened. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The always-on listening for "instruction" (WakeWordService.kt): off until the person turns it on. The CPU is held while it listens. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Automatic backup is on, so that the wallet's history (the WebView's storage) follows its owner to a new phone; the secrets are
         left out (res/xml/data_extraction_rules.xml): the 12 words are typed once there. -->
    <application android:name=".AiwaApp" android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="Aiwa Store" android:supportsRtl="true" android:theme="@style/Theme.Aiwa" android:networkSecurityConfig="@xml/network_security_config">
        <!-- The Store: the app's front door (StoreActivity.kt hosts the web app). -->
        <activity android:name=".StoreActivity" android:exported="true" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The dictation module's screen (optional): opened from the Store's Dictate tab. -->
        <activity android:name=".MainActivity" android:exported="false" android:label="Dictée Aiwa" android:windowSoftInputMode="adjustResize" />
        <!-- Reported live: the widget's mic opening the full app first,
             then dictation, looked slow and "moche" — a real trampoline
             Activity with no visible UI of its own hosts only what
             Android actually requires a real Activity for (the mic
             permission prompt, the system recognizer's own UI), then
             finishes itself — the user only ever sees the system
             recognizer's dialog appear directly. excludeFromRecents keeps
             this implementation detail out of the recent-apps switcher.
             Theme.Dictate (styles.xml) adds windowDisablePreview to stop
             the brief app-icon flash reported live on the FIRST tap
             (Android's cold-start preview window for a not-yet-resident
             process) — later taps, with the process already warm, never
             showed it in the first place. -->
        <!-- taskAffinity="" gives this activity a task of its own. Without
             it, launching it from the widget (a NEW_TASK start) joins
             Aiwa's existing task whenever the app was ever opened, and the
             whole task — MainActivity included — is brought to the front
             behind the overlay: the reported "the mic opens the app". -->
        <activity android:name=".DictateActivity" android:exported="true"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- The two list buttons of the widget open these small floating
             windows (see Pickers.kt). Same translucent, own-task setup as
             DictateActivity; not exported — the widget reaches them
             through a PendingIntent created by this app. -->
        <!-- "Installation manquante" (InstallHelpActivity.kt): copies the line that installs the backend in Termux. -->
        <activity android:name=".InstallHelpActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".SessionPickerActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".ModelPickerActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".OpenCodeActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".ApkDownloadActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".DocsPickerActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".DeployPickerActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".RepoPickerActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- The one-time set-up (SetupActivity.kt): the launcher opens it when the widget
             is put on the screen, and the widget opens it while a permission is missing. -->
        <activity android:name=".SetupActivity" android:exported="true"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity android:name=".ExtraReposPickerActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- "Connecter Claude" (ClaudeLoginActivity.kt): the user leaves for the browser and must come
             back to the SAME window, so it stays in the recent apps and is single-task. -->
        <activity android:name=".ClaudeLoginActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />
        <!-- "État d'Aiwa" (HealthActivity in Pickers.kt), and the widget's Store button
             (OpenStoreActivity.kt: opens the Store's publish sheet with the app Claude sent). -->
        <activity android:name=".HealthActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".OpenStoreActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".OpenResultActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- The widget's "update ready" button: opens the Store on the downloaded release. -->
        <activity android:name=".UpdateStoreActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- The widget's site and Actions buttons: no UI, they open what the state of the moment says (and the red dot is looked at). -->
        <activity android:name=".SiteButtonActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".OpenActionsActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- The repositories Claude reads for inspiration (Pickers.kt). -->
        <activity android:name=".SourceReposPickerActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- The site button when the site does not answer: Pages settings of the repository, with a line on what to choose. -->
        <activity android:name=".OpenPagesSettingsActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- The widget's "Claude ↗" button: no UI, opens the current cloud
             session in the Claude app (OpenClaudeActivity.kt). -->
        <activity android:name=".OpenClaudeActivity" android:exported="false"
            android:theme="@style/Theme.Dictate"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".AiwaWidgetReceiver" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/dictation_widget_info" />
        </receiver>
        <service android:name=".KeepAliveService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Garde Aiwa actif pour que le micro du widget reste instantane" />
        </service>
        <service android:name=".WakeWordService" android:exported="false" android:foregroundServiceType="microphone" />
    </application>
</manifest>
