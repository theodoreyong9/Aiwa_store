[{"at": 2.292, "text": "Imagine."}, {"at": 3.725, "text": "Documents."}, {"at": 5.158, "text": "Vidéos."}, {"at": 6.304, "text": "Jeux."}, {"at": 7.45, "text": "Sites internet."}, {"at": 9.456, "text": "Applications Android."}, {"at": 11.748, "text": "Smart contracts."}, {"at": 13.754, "text": "Dis-le au widget."}, {"at": 16.333, "text": "Ou même à ton écran de verrouillage."}, {"at": 19.198, "text": "Ou à ta lunette connectée."}, {"at": 22.063, "text": "Crée des campagnes."}, {"at": 23.783, "text": "Personnalisées."}, {"at": 25.502, "text": "Et multicanaux."}, {"at": 27.221, "text": "En un clic."}, {"at": 28.94, "text": "Crée des conversations inter-sessions."}, {"at": 31.519, "text": "Pilote un super agent."}, {"at": 33.238, "text": "Qui te parle."}, {"at": 34.385, "text": "Et te pousse à créer."}, {"at": 36.124, "text": "Et ouvre-le aux autres agents."}, {"at": 38.124, "text": "Une porte M C P."}, {"at": 40.104, "text": "Et vote."}, {"at": 41.25, "text": "Pour les mises à jour."}, {"at": 43.256, "text": "Une nouvelle idée du web."}, {"at": 45.261, "text": "Un web interplanétaire."}, {"at": 47.267, "text": "Et sans permission."}, {"at": 49.436, "text": "Ton univers. Ta volonté."}]