[{"at": 2.292, "text": "Imagine."}, {"at": 3.725, "text": "Documents."}, {"at": 5.158, "text": "Vidéos."}, {"at": 6.304, "text": "Jeux."}, {"at": 7.45, "text": "Sites internet."}, {"at": 9.456, "text": "Applications Android."}, {"at": 11.748, "text": "Smart contracts."}, {"at": 13.754, "text": "Dis-le au widget."}, {"at": 16.333, "text": "Ou même à ton écran éteint."}, {"at": 19.198, "text": "Ou à tes lunettes connectées."}, {"at": 22.063, "text": "Crée des campagnes."}, {"at": 23.783, "text": "Personnalisées."}, {"at": 25.502, "text": "Crée des conversations inter-sessions."}, {"at": 28.081, "text": "Pilote un super agent."}, {"at": 29.8, "text": "Qui te parle."}, {"at": 30.947, "text": "Et te pousse à créer."}, {"at": 32.666, "text": "Lance des scénarios."}, {"at": 34.296, "text": "Et bien plus encore."}, {"at": 36.066, "text": "Et vote."}, {"at": 37.212, "text": "Pour les mises à jour."}, {"at": 39.218, "text": "Une nouvelle idée du web."}, {"at": 41.223, "text": "Un web interplanétaire."}, {"at": 43.229, "text": "Et sans permission."}, {"at": 45.398, "text": "Ton univers. Ta volonté."}]