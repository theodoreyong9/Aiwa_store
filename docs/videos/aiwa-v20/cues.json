[{"at": 2.292, "text": "Imagine."}, {"at": 6.877, "text": "Dis-le au widget."}, {"at": 9.456, "text": "Ou même à ton écran de verrouillage."}, {"at": 12.321, "text": "Ou à ta lunette connectée."}, {"at": 15.186, "text": "Crée des campagnes."}, {"at": 16.906, "text": "Personnalisées."}, {"at": 18.625, "text": "Et multicanaux."}, {"at": 20.344, "text": "En un clic."}, {"at": 22.063, "text": "Crée des conversations inter-sessions."}, {"at": 24.642, "text": "Pilote un super agent."}, {"at": 26.361, "text": "Qui te parle."}, {"at": 27.508, "text": "Et te pousse à créer."}, {"at": 29.227, "text": "De plus en plus fort."}, {"at": 30.946, "text": "Et vote."}, {"at": 32.092, "text": "Pour les mises à jour."}, {"at": 34.098, "text": "Une nouvelle idée du web."}, {"at": 36.104, "text": "Un web interplanétaire."}, {"at": 38.109, "text": "Et sans permission."}, {"at": 40.279, "text": "Ton univers. Ta volonté."}]