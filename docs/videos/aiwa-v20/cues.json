[{"at": 2.292, "text": "Imagine."}, {"at": 9.169, "text": "Dis-le au widget."}, {"at": 11.748, "text": "Ou même à ton écran de verrouillage."}, {"at": 14.613, "text": "Ou à ta lunette connectée."}, {"at": 17.479, "text": "Crée des campagnes."}, {"at": 19.198, "text": "Personnalisées."}, {"at": 20.917, "text": "Et multicanaux."}, {"at": 22.636, "text": "En un clic."}, {"at": 24.356, "text": "Crée des conversations inter-sessions."}, {"at": 26.935, "text": "Pilote un super agent."}, {"at": 28.654, "text": "Qui te parle."}, {"at": 29.8, "text": "Et te pousse à créer."}, {"at": 31.519, "text": "De plus en plus fort."}, {"at": 34.098, "text": "Et vote."}, {"at": 35.244, "text": "Pour les mises à jour."}, {"at": 37.25, "text": "Une nouvelle idée du web."}, {"at": 39.256, "text": "Un web interplanétaire."}, {"at": 41.261, "text": "Et sans permission."}, {"at": 43.431, "text": "Ton univers. Ta volonté."}]