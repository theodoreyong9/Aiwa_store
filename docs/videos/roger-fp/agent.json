[{"at": 8.4, "text": "Pas encore."}, {"at": 22.1, "text": "Compris. Je lance ?"}, {"at": 25.2, "text": "Ça tourne."}, {"at": 28.6, "text": "C'est prêt. Premier site, sur la télé."}, {"at": 37.4, "text": "Envoyé."}, {"at": 38.9, "text": "Deuxième site, sur la télé."}, {"at": 48.2, "text": "Envoyé."}, {"at": 55.1, "text": "Elle est terminée. Je la passe sur la télé."}, {"at": 110.6, "text": "Ce n'est pas encore terminé."}, {"at": 117.1, "text": "C'est fait. Environ deux minutes."}]