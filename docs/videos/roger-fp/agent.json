[{"at": 13.25, "text": "Compris. Je cherche les annonces et je te prépare tout."}, {"at": 42.98, "text": "Pas encore."}, {"at": 56.68, "text": "Compris. Je lance ?"}, {"at": 59.78, "text": "Ça tourne."}, {"at": 63.18, "text": "C'est prêt. Premier site, sur la télé."}, {"at": 71.98, "text": "Envoyé."}, {"at": 73.48, "text": "Deuxième site, sur la télé."}, {"at": 82.78, "text": "Envoyé."}, {"at": 89.68, "text": "Elle est terminée. Je la passe sur la télé."}, {"at": 148.58, "text": "Ce n'est pas encore terminé."}, {"at": 155.08, "text": "C'est fait. Environ deux minutes."}, {"at": 202.61, "text": "Envoyé, avec la lettre et le lien de l'annonce."}, {"at": 221.53, "text": "Scénario entretien lancé. Je t'écoute."}]