[{"at": 13.14, "text": "Compris. Je cherche les annonces et je te prépare tout."}, {"at": 23.15, "text": "Pas encore."}, {"at": 36.85, "text": "Compris. Je lance ?"}, {"at": 39.95, "text": "Ça tourne."}, {"at": 43.35, "text": "C'est prêt. Premier site, sur la télé."}, {"at": 52.15, "text": "Envoyé."}, {"at": 53.65, "text": "Deuxième site, sur la télé."}, {"at": 62.95, "text": "Envoyé."}, {"at": 69.85, "text": "Elle est terminée. Je la passe sur la télé."}, {"at": 131.11, "text": "Ce n'est pas encore terminé."}, {"at": 137.61, "text": "C'est fait. Environ deux minutes."}]