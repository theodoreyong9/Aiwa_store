[{"at": 0.6, "text": "Crée ce que tu veux."}, {"at": 3.3, "text": "Même écran éteint."}, {"at": 5.2, "text": "Dis-le. C'est fait."}, {"at": 14.35, "text": "Un match CV recruteur. Sans serveur."}, {"at": 20.65, "text": "Un site. Une appli. Un contrat."}, {"at": 32.45, "text": "Un store sans permission."}, {"at": 53.05, "text": "Paie hors ligne."}, {"at": 63.05, "text": "Terre. Mars. En même temps."}, {"at": 71.45, "text": "Une clé par agent."}, {"at": 84.4, "text": "Une architecture centrée sur l'agent."}, {"at": 88.7, "text": "Construire et déployer : zéro clic."}, {"at": 91.1, "text": "Classer : zéro permission."}, {"at": 93.3, "text": "Payer : zéro réseau."}, {"at": 95.5, "text": "Se connecter : zéro login."}, {"at": 100.0, "text": "La réalité est le réseau."}, {"at": 104.6, "text": "Après la voix, le regard."}, {"at": 107.7, "text": "Des lunettes. Un capteur optique."}, {"at": 111.4, "text": "Tu regardes quelqu'un. Son profil apparaît, là où il se tient."}, {"at": 118.5, "text": "Seulement si elle l'a choisi."}, {"at": 124.5, "text": "Un intérêt commun. Une partie. Sans monde virtuel."}, {"at": 132.0, "text": "Le vrai défi : relier un signal à la bonne personne."}, {"at": 138.5, "text": "Étape un : prouver la proximité."}, {"at": 144.5, "text": "Nous cherchons des partenaires."}, {"at": 151.05, "text": "Nous ne voulons pas augmenter le monde."}, {"at": 154.45, "text": "Nous voulons augmenter les possibilités de la société humaine."}]