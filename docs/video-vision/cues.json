[{"at": 0.6, "text": "Crée ce que tu veux."}, {"at": 3.3, "text": "Même écran éteint."}, {"at": 5.05, "text": "Tu choisis ton mot d'éveil."}, {"at": 6.95, "text": "Même Aïwa."}, {"at": 9.45, "text": "Dis-le. C'est fait."}, {"at": 18.6, "text": "Un match CV recruteur. Sans serveur."}, {"at": 24.9, "text": "Un site. Une appli. Un contrat."}, {"at": 36.7, "text": "Un store sans permission."}, {"at": 57.3, "text": "Paie hors ligne."}, {"at": 67.3, "text": "Terre. Mars. En même temps."}, {"at": 75.7, "text": "Une clé par agent."}, {"at": 88.65, "text": "Une architecture centrée sur l'agent."}, {"at": 92.95, "text": "Construire et déployer : zéro clic."}, {"at": 95.35, "text": "Classer : zéro permission."}, {"at": 97.55, "text": "Payer : zéro réseau."}, {"at": 99.75, "text": "Se connecter : zéro login."}, {"at": 104.25, "text": "La réalité est le réseau."}, {"at": 108.85, "text": "Après la voix, le regard."}, {"at": 111.95, "text": "Des lunettes. Un capteur optique."}, {"at": 115.65, "text": "Tu regardes quelqu'un. Son profil apparaît, là où il se tient."}, {"at": 122.75, "text": "Seulement si elle l'a choisi."}, {"at": 128.75, "text": "Un intérêt commun. Une partie. Sans monde virtuel."}, {"at": 136.25, "text": "Le vrai défi : relier un signal à la bonne personne."}, {"at": 142.75, "text": "Étape un : prouver la proximité."}, {"at": 148.75, "text": "Nous cherchons des partenaires."}, {"at": 155.3, "text": "Nous ne voulons pas augmenter le monde."}, {"at": 158.7, "text": "Nous voulons augmenter les possibilités de la société humaine."}]